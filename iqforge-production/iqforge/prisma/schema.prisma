datasource db { provider="postgresql" url=env("DATABASE_URL") }
generator client { provider="prisma-client-js" }
enum Role { USER ADMIN }
enum QuestionCategory { numerical verbal logical spatial abstract working_memory processing_speed quantitative fluid pattern }
enum QuestionType { sequence matrix odd_one_out analogy deduction rotation symbol_sequence transformation classification memory speed word_problem pattern_completion }
model User { id String @id @default(cuid()) name String email String @unique passwordHash String? emailVerified DateTime? image String? role Role @default(USER) leaderboardVisible Boolean @default(false) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt assessments Assessment[] practiceSessions PracticeSession[] progress UserProgress? flaggedSessions FlaggedSession[] }
model Question { id String @id @default(cuid()) category QuestionCategory difficulty Int questionType QuestionType prompt String options Json correctAnswer String explanation String timeLimitMs Int metadata Json? active Boolean @default(true) createdAt DateTime @default(now()) responses AssessmentResponse[] practiceResponses PracticeResponse[] dailyChallenges DailyChallenge[] @@index([category,difficulty,active]) }
model Assessment { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) status String @default("in_progress") startedAt DateTime @default(now()) completedAt DateTime? theta Float @default(0) percentile Float? abilityLow Int? abilityHigh Int? confidence Float? rawScore Int? normalizedScore Int? categoryScores Json? responseTimeStats Json? behaviorFlags Json? aiStatus String @default("pending") aiAnalysis AIAnalysis? responses AssessmentResponse[] flaggedSession FlaggedSession? @@index([userId,createdAt]) }
model AssessmentResponse { id String @id @default(cuid()) assessmentId String questionId String assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade) question Question @relation(fields:[questionId],references:[id]) answer String? correct Boolean? responseTimeMs Int tabSwitches Int @default(0) answeredAt DateTime @default(now()) @@unique([assessmentId,questionId]) @@index([assessmentId,answeredAt]) }
model AIAnalysis { id String @id @default(cuid()) assessmentId String @unique assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade) payload Json createdAt DateTime @default(now()) }
model PracticeSession { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) mode String difficulty String score Int? createdAt DateTime @default(now()) responses PracticeResponse[] @@index([userId,createdAt]) }
model PracticeResponse { id String @id @default(cuid()) sessionId String questionId String session PracticeSession @relation(fields:[sessionId],references:[id],onDelete:Cascade) question Question @relation(fields:[questionId],references:[id]) answer String? correct Boolean responseTimeMs Int createdAt DateTime @default(now()) }
model DailyChallenge { id String @id @default(cuid()) date DateTime @unique questionId String question Question @relation(fields:[questionId],references:[id]) }
model UserProgress { id String @id @default(cuid()) userId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) streak Int @default(0) challengeAccuracy Float @default(0) fastestResponseMs Int? updatedAt DateTime @updatedAt }
model FlaggedSession { id String @id @default(cuid()) userId String assessmentId String @unique user User @relation(fields:[userId],references:[id],onDelete:Cascade) assessment Assessment @relation(fields:[assessmentId],references:[id],onDelete:Cascade) reasons Json createdAt DateTime @default(now()) resolved Boolean @default(false) @@index([resolved,createdAt]) }
model RateLimit { key String @id count Int windowStart DateTime }
model AuthToken { id String @id @default(cuid()) userId String type String tokenHash String @unique expiresAt DateTime usedAt DateTime? createdAt DateTime @default(now()) @@index([userId,type,expiresAt]) }
